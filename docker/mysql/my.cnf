[mysqld]
# Full Unicode including emoji and non-BMP characters. `utf8mb3` (MySQL's
# legacy "utf8") silently truncates them.
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

default_authentication_plugin = caching_sha2_password

max_connections = 200
max_allowed_packet = 64M

# InnoDB buffer pool holds the working set in memory. Tune to roughly 70% of
# the container's memory limit in production; 512M suits local development.
innodb_buffer_pool_size = 512M
innodb_log_file_size    = 128M

# 2 = flush once per second rather than on every commit. Faster, and risks at
# most one second of transactions on an OS crash. Set to 1 in production where
# durability outweighs throughput.
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# Strict mode rejects silent data truncation, matching the `strict` flag in
# Laravel's database config so development surfaces the same errors as prod.
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

skip-name-resolve

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
