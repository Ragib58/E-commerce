<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Fixed key so tests never depend on a generated .env. -->
        <env name="APP_KEY" value="base64:Xh3vN2qLpR8sT5wYzB1cD4fG7jK0mN9oP2rS5uV8xA0="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_DEBUG" value="true"/>

        <!-- In-memory SQLite: the schema uses no engine-specific types, so
             migrations run identically here and on MySQL/PostgreSQL. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!-- `array` supports cache tags, so the tagged settings cache is
             exercised for real rather than silently bypassed. -->
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>

        <env name="FRONTEND_REVALIDATION_ENABLED" value="false"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
