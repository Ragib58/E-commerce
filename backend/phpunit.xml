<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <!--
        force="true" on every variable below.

        Without it, a value already present in the real process environment
        wins over the one declared here. In Docker that is always the case:
        docker-compose loads backend/.env into the container as genuine
        environment variables, so `php artisan test` inside the container would
        otherwise run against the *development* Redis, MySQL, and mail
        transport — and against APP_ENV=local.

        Forcing them keeps the suite hermetic wherever it runs: in the
        container, on a bare host, and in CI.
    -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Fixed key so tests never depend on a generated .env. -->
        <env name="APP_KEY" value="base64:Xh3vN2qLpR8sT5wYzB1cD4fG7jK0mN9oP2rS5uV8xA0=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="APP_DEBUG" value="true" force="true"/>

        <!-- In-memory SQLite: the schema uses no engine-specific types, so
             migrations run identically here and on MySQL/PostgreSQL. -->
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>

        <!-- `array` supports cache tags, so the tagged settings cache is
             exercised for real rather than silently bypassed. -->
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="FILESYSTEM_DISK" value="local" force="true"/>

        <env name="FRONTEND_REVALIDATION_ENABLED" value="false" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
