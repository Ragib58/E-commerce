###############################################################################
# Application
###############################################################################
# APP_NAME is the *system* identifier used for queue names and cache prefixes.
# The customer-facing company name is admin-managed in the `settings` table and
# must never be read from here.
APP_NAME=Ecommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Public origin of the Next.js storefront. Used for CORS defaults and links.
FRONTEND_URL=http://localhost:3000

###############################################################################
# Logging
###############################################################################
# stderr keeps logs in the container's stdout stream where the orchestrator
# collects them. Use `daily` only outside containers.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

###############################################################################
# Database
###############################################################################
# Set DB_CONNECTION=pgsql and DB_PORT=5432 to run on PostgreSQL instead.
# `mysql` is the docker-compose service name; use 127.0.0.1 outside Docker.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

###############################################################################
# Redis
###############################################################################
# Logical databases are separated so `cache:clear` cannot destroy live
# sessions (DB 1) or drop queued jobs (DB 2).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2

###############################################################################
# Cache
###############################################################################
# MUST be `redis` in any real environment: the settings layer relies on cache
# tags for event-driven invalidation, and tags silently no-op on the `file`
# driver, causing stale branding to be served.
CACHE_STORE=redis
CACHE_PREFIX=ecommerce_cache_
CACHE_TTL_SETTINGS=86400
CACHE_TTL_MENUS=86400
CACHE_TTL_CATALOG=3600
CACHE_TTL_HEALTH=10

###############################################################################
# Session (admin panel)
###############################################################################
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Leading-dot domain (".example.com") to share cookies with a subdomain SPA.
SESSION_DOMAIN=null

###############################################################################
# Queue
###############################################################################
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120

###############################################################################
# Filesystem / Object Storage
###############################################################################
# `public` writes to storage/app/public (requires `storage:link`).
# `s3` targets MinIO locally and any S3-compatible provider in production.
FILESYSTEM_DISK=public

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ecommerce
# Internal endpoint the container uses to reach MinIO over the Docker network.
AWS_ENDPOINT=http://minio:9000
# Browser-reachable URL for generated asset links; differs from AWS_ENDPOINT
# because the browser cannot resolve the Docker service name.
AWS_URL=http://localhost:9002/ecommerce
# MinIO requires path-style addressing; real S3 does not.
AWS_USE_PATH_STYLE_ENDPOINT=true

UPLOAD_MAX_IMAGE_KB=4096
UPLOAD_MAX_FILE_KB=10240

###############################################################################
# API
###############################################################################
API_DEFAULT_VERSION=v1
API_RATE_LIMIT_PUBLIC=60
API_RATE_LIMIT_AUTH=120
API_RATE_LIMIT_HEALTH=30
API_PER_PAGE=20
API_MAX_PER_PAGE=100

# Credential endpoints. Two limits apply to each: a tight one keyed on
# email+IP, and a wider per-IP one that catches an attacker rotating the email
# to stay under the first.
API_RATE_LIMIT_AUTH_ATTEMPTS=5
API_RATE_LIMIT_AUTH_PER_IP=20
API_RATE_LIMIT_ADMIN_AUTH=5
API_RATE_LIMIT_ADMIN_AUTH_PER_IP=10

# Requests per window (minutes). Each of these sends an email, so the limit
# protects mailboxes and sender reputation as well as the application.
API_RATE_LIMIT_PASSWORD_RESET=3
API_RATE_LIMIT_PASSWORD_RESET_WINDOW=15
API_RATE_LIMIT_VERIFICATION=5
API_RATE_LIMIT_VERIFICATION_WINDOW=15

###############################################################################
# Authentication & Access Control
###############################################################################
# Staff tokens expire far sooner than customer tokens: a stolen staff token is
# worth considerably more.
AUTH_CUSTOMER_TOKEN_TTL=10080
AUTH_ADMIN_TOKEN_TTL=480

# Revoke all OTHER sessions when a password changes, so a session opened with
# the old password cannot outlive it. Leave enabled.
AUTH_REVOKE_TOKENS_ON_PASSWORD_CHANGE=true

AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900

# Resolved admin permission sets. A backstop only — the cache is flushed
# explicitly whenever roles or permissions change, so revocation is immediate.
CACHE_TTL_PERMISSIONS=3600

###############################################################################
# Bootstrap Super Admin (consumed by SuperAdminSeeder)
###############################################################################
# Leave SUPER_ADMIN_PASSWORD blank to have a strong password generated and
# printed ONCE during `db:seed`. There is deliberately no hardcoded default,
# so an installation cannot ship with known credentials.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

###############################################################################
# CORS
###############################################################################
# Comma-separated EXACT origins. A wildcard is invalid here because
# CORS_SUPPORTS_CREDENTIALS=true — browsers reject that combination.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=true
CORS_MAX_AGE=86400

###############################################################################
# Sanctum (authentication phase)
###############################################################################
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000,frontend:3000
SANCTUM_TOKEN_EXPIRATION=10080

###############################################################################
# Frontend Cache Revalidation
###############################################################################
# When admin content changes, Laravel calls this endpoint so the storefront
# drops its cached copy without a redeploy. The secret MUST match
# REVALIDATION_SECRET in frontend/.env.local.
FRONTEND_REVALIDATION_ENABLED=true
FRONTEND_REVALIDATION_URL=http://frontend:3000/api/revalidate
FRONTEND_REVALIDATION_SECRET=change-me-to-a-long-random-string
FRONTEND_REVALIDATION_TIMEOUT=5

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
