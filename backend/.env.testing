# Test environment.
#
# Laravel loads this file instead of .env whenever APP_ENV=testing, which
# phpunit.xml sets. It is committed deliberately: it contains no secrets, only
# the drivers that keep the suite hermetic.
#
# Without this file the suite is not isolated. `docker-compose` loads
# backend/.env into the container as real environment variables, and Laravel
# skips .env entirely under APP_ENV=testing — so the app would boot with the
# development Redis and MySQL still set in the process environment, and with no
# APP_KEY at all.
#
# The values here mirror the <env> block in phpunit.xml.

APP_NAME="Ecommerce (testing)"
APP_ENV=testing

# Fixed, non-secret key. Tests must never depend on a generated .env, and this
# key protects nothing — it exists so the encrypter can boot.
APP_KEY=base64:Xh3vN2qLpR8sT5wYzB1cD4fG7jK0mN9oP2rS5uV8xA0=

APP_DEBUG=true
APP_URL=http://localhost
APP_MAINTENANCE_DRIVER=file

# In-memory SQLite: the schema uses no engine-specific types, so migrations run
# identically here and on MySQL/PostgreSQL. Each test gets a fresh database.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# `array` supports cache tags, so the tagged settings cache is exercised for
# real rather than silently bypassed as it would be on the `file` driver.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Local disk; media tests call Storage::fake() and never touch it.
FILESYSTEM_DISK=local

# No outbound HTTP from the test suite.
FRONTEND_REVALIDATION_ENABLED=false
FRONTEND_URL=http://localhost:3000

# Cheapest valid cost — hashing speed dominates auth test runtime.
BCRYPT_ROUNDS=4

TELESCOPE_ENABLED=false
LOG_CHANNEL=stack
LOG_LEVEL=debug
