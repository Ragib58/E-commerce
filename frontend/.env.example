###############################################################################
# Public — inlined into the browser bundle at build time.
# NEVER put a secret in a NEXT_PUBLIC_* variable; it ships to every visitor.
###############################################################################

# Base URL the BROWSER uses to reach the API. Must be publicly resolvable —
# a Docker service name will not work here.
# Through the Nginx edge (recommended, mirrors production):
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_VERSION=v1

# Public origin of this storefront. Used for canonical URLs and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: production CDN hostname for admin-uploaded assets, added to the
# next/image allowlist. Leave blank in development.
NEXT_PUBLIC_ASSET_HOSTNAME=

###############################################################################
# Server-only — never exposed to the browser.
###############################################################################

# Base URL the SERVER (RSC, route handlers) uses to reach the API. Inside
# Docker this is the internal service address, which avoids a round-trip out
# through the host. Set automatically by docker-compose; needed here only when
# running `npm run dev` outside Docker.
INTERNAL_API_URL=http://localhost:8080/api/v1

# Shared secret Laravel presents when asking this app to purge cached content.
# MUST match FRONTEND_REVALIDATION_SECRET in backend/.env, and must be at
# least 16 characters or startup validation fails.
REVALIDATION_SECRET=change-me-to-a-long-random-string
