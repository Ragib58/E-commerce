###############################################################################
# Root environment — consumed by docker-compose.yml ONLY.
#
# Copy to `.env` in this directory. This file does NOT configure the
# applications themselves; those read backend/.env and frontend/.env.local.
###############################################################################

# Host uid/gid baked into the PHP image so files the container writes
# (migrations, caches) remain editable on the host. On Linux/macOS run
# `id -u` and `id -g`. On Windows the defaults are correct.
UID=1000
GID=1000

# Published host ports. Change these if something already occupies them.
NGINX_PORT=8080
FRONTEND_PORT=3000

# Host-side ports for direct database/cache access from a GUI client. These
# are intentionally non-default so they cannot collide with a local MySQL or
# Redis already running on 3306/6379.
DB_PORT_FORWARD=3307
REDIS_PORT_FORWARD=6380

# MySQL credentials. Must match DB_* in backend/.env — compose creates the
# database and user from these values on first boot.
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# MinIO (S3-compatible object storage) credentials and bucket.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET=ecommerce
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003

# Mailpit — captures all outbound mail in development.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
